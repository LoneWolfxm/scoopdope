# scoopdope Environment Variables
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# Never commit your real `.env` file. Placeholder values below are safe defaults
# for local development only.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Swagger / API docs (served at /api/docs)
# ---------------------------------------------------------------------------
# Swagger UI is disabled automatically when NODE_ENV=production. Set to `true`
# to explicitly enable it in production (not recommended unless the docs are
# protected). Local and staging environments serve Swagger regardless of this
# value.
SWAGGER_ENABLED=false
# When Swagger is enabled in production, /api/docs is protected with HTTP Basic
# Auth. The username is `admin` and this value is the password. Leave empty to
# keep the docs unreachable in production. Use a long, random value.
SWAGGER_PASSWORD=

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=scoopdope
DATABASE_USERNAME=scoopdope
DATABASE_PASSWORD=change-me

# Connection pool tuning (see docs/environment-variables.md)
# Maximum number of connections in the pool. Raise for high-traffic deployments;
# keep well below the PostgreSQL server's max_connections limit.
DB_POOL_MAX=20
# Milliseconds to wait for a connection before failing with a timeout error.
DB_POOL_CONNECTION_TIMEOUT_MS=2000

# ---------------------------------------------------------------------------
# Redis (caching & session management)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# ---------------------------------------------------------------------------
# Stellar network
# ---------------------------------------------------------------------------
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STELLAR_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---------------------------------------------------------------------------
# Frontend (Next.js) — must be prefixed with NEXT_PUBLIC_ to reach the browser
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_GIT_COMMIT_SHA=

# KYC
KYC_PROVIDER_API_KEY=

# AWS (used for Comprehend content moderation)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Content Moderation
MODERATION_TOXICITY_THRESHOLD=0.7

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_API_KEY=

# Stripe (fiat payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRO_PRICE_ID=price_your_pro_price_id
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_price_id
# Set to false to disable prorated subscription refunds (for promotional plans, for example).
STRIPE_SUBSCRIPTION_PRORATION_ENABLED=true

# Exchange Rate API (optional — omit to use free open.er-api.com)
# Get a key at https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=

# OpenTelemetry (Tracing)
# Sampling rate for traces (0.0-1.0). Use 1.0 for development to sample all traces.
# In production, consider using 0.1 or lower to reduce trace volume and storage costs.
OTEL_SAMPLING_RATE=1.0

# Survey pseudonymization (#1241)
# Server-side secret used to HMAC survey userIds into deterministic pseudoIds for
# analytics exports. Must be a long random string and must NEVER be exposed to
# clients (do not prefix with NEXT_PUBLIC_). Rotating it changes all pseudoIds.
SURVEY_PSEUDONYMIZATION_SECRET=change-me-to-a-long-random-string

# Web Push / VAPID (required for browser push notifications — #1019)
# Generate a new key pair once with:
#   node -e "const wp=require('web-push'); const keys=wp.generateVAPIDKeys(); console.log('Public:', keys.publicKey); console.log('Private:', keys.privateKey);"
# Then commit only the PUBLIC key to version control. Keep the PRIVATE key secret.
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@scoopdope.com

# ---------------------------------------------------------------------------
# Study groups
# ---------------------------------------------------------------------------
# Lifetime (in days) of study group invite links before they expire (#1150).
INVITE_LINK_TTL_DAYS=7
