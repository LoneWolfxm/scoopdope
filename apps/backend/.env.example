# Server
# Port the HTTP server listens on
PORT=3000
# Expose Swagger/OpenAPI docs at /api/docs (never enable in production)
ENABLE_SWAGGER=false
# Runtime environment: development | test | production
NODE_ENV=development
# Public base URL of the API (used for links, callbacks and OpenAPI servers)
API_BASE_URL=http://localhost:3000
# Write the generated OpenAPI document to disk on boot (used by CI/docs tooling)
EXPORT_OPENAPI=false
# Path where the exported OpenAPI document is written
OPENAPI_OUTPUT_PATH=openapi.json

# Swagger / API Docs
# Production docs access policy:
#   - Swagger UI at /api/docs is disabled when NODE_ENV=production unless
#     SWAGGER_ENABLED=true is explicitly set.
#   - When enabled in production, /api/docs is protected with HTTP Basic Auth
#     using the credentials below (username "admin", password SWAGGER_PASSWORD).
#   - Local and staging environments serve Swagger normally.
#   - The static API docs exported to GitHub Pages are unaffected by these flags.
# Set to true to serve Swagger UI (required in production).
SWAGGER_ENABLED=false
# Password for HTTP Basic Auth on /api/docs in production. Required when
# SWAGGER_ENABLED=true and NODE_ENV=production.
SWAGGER_PASSWORD=

# Static Assets
# In production, static assets are served by a CDN or nginx instead of the
# Express app. Set this to the public base URL of that CDN/nginx origin so the
# app can reference assets without serving them itself.
# Leave empty in development/test to keep Express serving static files locally.
STATIC_ASSETS_BASE_URL=

# Logging
# Minimum log level: error | warn | info | debug | verbose
LOG_LEVEL=info
# Log output format: json (production) or pretty (development)
LOG_FORMAT=pretty

# Database
# PostgreSQL host
DATABASE_HOST=localhost
# PostgreSQL port
DATABASE_PORT=5432
# PostgreSQL user
DATABASE_USER=your_db_user
# PostgreSQL password
DATABASE_PASSWORD=your_db_password
# PostgreSQL database name
DATABASE_NAME=scoopdope
# Set to true to require TLS when connecting to PostgreSQL
DATABASE_SSL=false
# Connection pooling
# Minimum number of idle connections kept in the pool
DATABASE_POOL_MIN=5
# Maximum number of connections in the pool
DATABASE_POOL_MAX=20
# Milliseconds an idle connection is kept before being closed
DATABASE_IDLE_TIMEOUT_MS=30000
# Milliseconds to wait for a new connection before failing
DATABASE_CONNECTION_TIMEOUT_MS=10000
# Milliseconds a single statement may run before being aborted
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Auth
# Secret used to sign JWT access tokens (use a long random value)
JWT_SECRET=your_jwt_secret
# JWT access token lifetime (e.g. 15m, 1h)
JWT_EXPIRES_IN=1h
# Secret used to sign JWT refresh tokens (must differ from JWT_SECRET)
JWT_REFRESH_SECRET=your_jwt_refresh_secret
# JWT refresh token lifetime (e.g. 7d)
JWT_REFRESH_EXPIRES_IN=7d
# bcrypt cost factor used when hashing passwords
BCRYPT_SALT_ROUNDS=10

# Google OAuth
# OAuth client ID from the Google Cloud console
GOOGLE_CLIENT_ID=your_google_client_id
# OAuth client secret from the Google Cloud console
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Callback URL registered with Google (must match exactly)
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Stellar
# Network to use: testnet or mainnet
STELLAR_NETWORK=testnet
# Secret key of the platform Stellar account (never commit a real key)
STELLAR_SECRET_KEY=your_stellar_secret_key
# Public key of the platform Stellar account
STELLAR_PUBLIC_KEY=your_stellar_public_key
# Horizon URL (testnet: https://horizon-testnet.stellar.org, mainnet: https://horizon.stellar.org)
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Whether Horizon outages fail /health (true) or are reported as warning-only (false)
STELLAR_HEALTH_CRITICAL=true

# Soroban
# Soroban RPC URL (testnet: https://soroban-testnet.stellar.org, mainnet: https://soroban.stellar.org)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Network passphrase used for Soroban transaction simulation/submission
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Maximum fee (in stroops) willing to be paid per Soroban transaction
SOROBAN_FEE=100000
# Milliseconds to wait for a Soroban transaction to be confirmed
SOROBAN_TX_TIMEOUT_MS=30000
# Contract IDs must be valid Stellar contract IDs (56-char StrKey starting with 'C')
# Main Scoopdope Soroban contract ID
SOROBAN_CONTRACT_ID=your_soroban_contract_id
# Enrollment contract ID
ENROLLMENT_CONTRACT_ID=your_enrollment_contract_id
# Analytics contract ID
ANALYTICS_CONTRACT_ID=your_analytics_contract_id
# Token (Scoopdope token) contract ID
TOKEN_CONTRACT_ID=your_token_contract_id
# Certificate/NFT contract ID
CERTIFICATE_CONTRACT_ID=your_certificate_contract_id

# Redis
# Connection URL for the Redis instance used for caching and queues
REDIS_URL=redis://localhost:6379
# Optional Redis password (leave empty if not required)
REDIS_PASSWORD=
# Redis logical database index
REDIS_DB=0

# Throttler
# Rate-limit window in milliseconds
THROTTLE_TTL=60000
# Maximum number of requests allowed per window per client
THROTTLE_LIMIT=100

# Email
# Set to true to actually send emails (false logs them instead)
EMAIL_ENABLED=false
# SMTP server hostname
EMAIL_HOST=smtp.example.com
# SMTP server port (587 for STARTTLS, 465 for implicit TLS)
EMAIL_PORT=587
# Use implicit TLS (true for port 465, false for STARTTLS)
EMAIL_SECURE=false
# SMTP username
EMAIL_USER=your_email_user
# SMTP password
EMAIL_PASS=your_email_password
# Default From header for outgoing email
EMAIL_FROM="Scoopdope" <no-reply@Scoopdope.app>
# Public URL of the frontend, used to build links in emails
FRONTEND_URL=http://localhost:3001

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3001
# Allow cookies/credentials on cross-origin requests
CORS_CREDENTIALS=false
# How long (seconds) browsers may cache the preflight response
CORS_MAX_AGE=86400

# Sentry
# Sentry DSN for error reporting (leave empty to disable)
SENTRY_DSN=your_sentry_dsn_here
# Sentry environment tag (e.g. development, staging, production)
SENTRY_ENVIRONMENT=development
# Fraction of transactions sent to Sentry (0.0 - 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Git commit SHA attached to Sentry releases and health endpoints
GIT_COMMIT_SHA=

# VAPID Keys for Push Notifications
# Public key shared with browsers to subscribe to web push
VAPID_PUBLIC_KEY=your_vapid_public_key_here
# Private key used to sign push messages (keep secret)
VAPID_PRIVATE_KEY=your_vapid_private_key_here
# Contact URI (mailto: or https:) included in push requests
VAPID_SUBJECT=mailto:admin@scoopdope.com

# AWS
# AWS region for S3 and other services
AWS_REGION=us-east-1
# AWS access key ID (prefer IAM roles in production)
AWS_ACCESS_KEY_ID=your_access_key
# AWS secret access key (prefer IAM roles in production)
AWS_SECRET_ACCESS_KEY=your_secret_key
# S3 bucket used to store transcript uploads
AWS_TRANSCRIPT_BUCKET=your_transcript_bucket

# Payouts
# Number of payouts processed per batch
PAYOUT_BATCH_SIZE=500

# Study Groups
# Number of days a study group invite link remains valid before expiring.
INVITE_LINK_TTL_DAYS=7

# Query Monitoring & Performance
# Enable TypeORM query logging
DB_LOGGING=false
# Enable slow query logging
QUERY_LOG_ENABLED=false
# Slow query threshold in milliseconds (default: 1000ms)
DB_SLOW_QUERY_THRESHOLD=1000
# Statement timeout in milliseconds (development only)
DB_STATEMENT_TIMEOUT=30000
# Path to slow query log file
MONITORING_SLOW_QUERY_LOG_PATH=logs/slow-queries.log
# Slow query detection threshold (milliseconds)
MONITORING_SLOW_QUERY_THRESHOLD=1000
# Critical query threshold - queries exceeding this trigger alerts (milliseconds)
MONITORING_CRITICAL_QUERY_THRESHOLD=5000

# Test Environment
# Tests load these values instead of the development values above to prevent
# config bleed between the test and development environments.
# Copy this file to .env.test and adjust as needed.
# Runtime environment for the test suite
NODE_ENV=test
# Separate test database so tests never touch development data
DATABASE_NAME=scoopdope_test
# Minimal pool for fast test startup
DATABASE_POOL_MIN=1
# Small pool to avoid exhausting connections during parallel tests
DATABASE_POOL_MAX=5
# Use a separate Redis logical database for tests
REDIS_URL=redis://localhost:6379/1
# Only surface errors during tests
LOG_LEVEL=error
# Never send real emails from tests
EMAIL_ENABLED=false
# Disable Sentry reporting during tests
SENTRY_DSN=
# Disable query logging for quieter test output
DB_LOGGING=false
# Disable slow query logging during tests
QUERY_LOG_ENABLED=false
# High throttle limit so tests don't hit rate limits
THROTTLE_LIMIT=1000
